{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node16",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist/shared",
    "rootDir": ".",
    "declaration": false,
    "composite": false,
    "incremental": false
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "node_modules",
    "../dist"
  ]
}