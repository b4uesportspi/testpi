async function handleProfile(req: VercelRequest, res: VercelResponse) {
  console.log('Profile endpoint: Starting profile request handling');
  console.log('Profile endpoint: Request method:', req.method);
  console.log('Profile endpoint: Request headers:', req.headers);
  
  // Get the authorization token to extract user info
  // Support both standard Authorization header and Vercel's OIDC token
  const authHeader = req.headers.authorization || req.headers['x-vercel-oidc-token'];
  console.log('Profile endpoint: Auth header:', authHeader);
  
  // Check if we have a real Pi Server API Key
  console.log('Profile endpoint: Pi Server configured:', isPiServerConfigured());
  if (isPiServerConfigured()) {
    // If no auth header, this might be a direct browser access - return an appropriate response
    if (!authHeader) {
      console.log('Profile endpoint: No authorization header provided');
      return res.status(401).json({ message: 'No authorization header provided' });
    }
    
    try {
      // Ensure we're working with a string (headers can be arrays)
      const headerValue = Array.isArray(authHeader) ? authHeader[0] : authHeader;
      console.log('Profile endpoint: Header value:', headerValue);
      
      // Extract username and userId from JWT token
      // Strip the Bearer prefix if present
      const token = headerValue?.startsWith('Bearer ') ? headerValue.substring(7) : headerValue;

      console.log('Profile endpoint: Token:', token);
      
      // Validate token format first
      if (!token || token.split('.').length !== 3) {
        console.log('Profile endpoint: Malformed token or invalid JWT');
        return res.status(401).json({ message: 'Malformed token or invalid JWT' });
      }
      
      // Debug JWT header to check algorithm
      let header;
      try {
        header = JSON.parse(Buffer.from(token.split('.')[0], 'base64').toString());
        console.log('Profile endpoint: JWT Header:', header);
      } catch (decodeError) {
        console.log('Profile endpoint: Could not decode JWT header for debugging');
      }
      
      // Handle different token types
      if (header && header.alg === 'RS256') {
        // This is a Pi Network token - we should not accept it for profile endpoint
        // Profile endpoint should only accept our server-issued HS256 tokens
        console.log('Profile endpoint: Rejecting RS256 token - only HS256 tokens are accepted');
        return res.status(401).json({ message: 'Invalid token. Profile endpoint only accepts server-issued tokens.' });
      } else if (header && header.alg === 'HS256') {
        // This is our server-issued token - verify it
        console.log('Profile endpoint: Verifying HS256 token');
        // Verify the JWT token and extract user ID
        // Force HS256 algorithm for HMAC-signed tokens
        const jwtLib = await import('jsonwebtoken');
        const decoded: any = jwtLib.verify(token, JWT_SECRET, { algorithms: ['HS256'] });
        const userId = decoded.userId;
        console.log('Profile endpoint: Token verified, user ID:', userId);
        
        // Handle different HTTP methods
        if (req.method === 'GET') {
          // Fetch user data directly from database using raw SQL
          const client = await pool.connect();
          try {
            // First try to select with tokens column
            let result;
            try {
              result = await client.query(
                'SELECT id, pi_uid, username, email, phone, country, language, wallet_address, game_accounts, referral_code, is_active, is_profile_verified, tokens, profile_picture, created_at, updated_at FROM app_users WHERE id = $1',
                [userId]
              );
            } catch (columnError: any) {
              // If tokens column doesn't exist, try without it
              if (columnError.message && columnError.message.includes('tokens')) {
                console.log('Profile endpoint: tokens column not found, trying without it');
                result = await client.query(
                  'SELECT id, pi_uid, username, email, phone, country, language, wallet_address, game_accounts, referral_code, is_active, is_profile_verified, profile_picture, created_at, updated_at FROM app_users WHERE id = $1',
                  [userId]
                );
                // Add tokens field with default value to each row
                result.rows = result.rows.map(row => ({ ...row, tokens: 0 }));
              } else {
                throw columnError;
              }
            }
            
            if (result.rows.length === 0) {
              console.log('Profile endpoint: User not found for ID:', userId);
              return res.status(404).json({ message: 'User not found' });
            }
            
            // Map database columns to expected API response format
            let user = {
              id: result.rows[0].id,
              piUID: result.rows[0].pi_uid,
              username: result.rows[0].username,
              email: result.rows[0].email,
              phone: result.rows[0].phone,
              country: result.rows[0].country,
              language: result.rows[0].language,
              walletAddress: result.rows[0].wallet_address,
              gameAccounts: result.rows[0].game_accounts,
              // Updated to fetch referral code from the referral_codes table
              referralCode: await getUserReferralCode(result.rows[0].id),
              isActive: result.rows[0].is_active,
              isProfileVerified: result.rows[0].is_profile_verified,
              tokens: result.rows[0].tokens,
              profilePicture: result.rows[0].profile_picture,
              createdAt: result.rows[0].created_at,
              updatedAt: result.rows[0].updated_at,
            };
            
            console.log('Profile endpoint: User data fetched:', user);
            return res.status(200).json(user);
          } catch (error: any) {
            console.error('Profile endpoint: Error fetching user data:', error);
            return res.status(500).json({ message: 'Failed to fetch user data', error: error.message });
          } finally {
            client.release();
            console.log('Profile endpoint: Database connection released');
          }
        } else if (req.method === 'PUT') {
          // Update user profile
          const updateData = req.body;
          
          console.log('Profile endpoint: Updating profile for user', userId, 'with data size:', JSON.stringify(updateData).length);
          
          // Check if the request body is too large
          const requestBodySize = JSON.stringify(updateData).length;
          const maxSize = 5 * 1024 * 1024; // 5MB limit
          
          if (requestBodySize > maxSize) {
            console.log('Profile endpoint: Request body too large:', requestBodySize);
            return res.status(413).json({ 
              message: 'Request entity too large. Please reduce the size of your profile picture.',
              maxSize: maxSize,
              actualSize: requestBodySize
            });
          }
          
          // Validate required fields
          if (!updateData.email || !updateData.phone) {
            return res.status(400).json({ message: 'Email and phone number are required' });
          }

          // Validate email format
          if (updateData.email && !updateData.email.endsWith('@gmail.com')) {
            return res.status(400).json({ message: 'Email must be a Gmail address' });
          }

          // Optimize profile picture if it's too large
          if (updateData.profilePicture && updateData.profilePicture.startsWith('data:image')) {
            console.log('Profile endpoint: Profile picture detected, size:', updateData.profilePicture.length);
            
            // If profile picture is larger than 1MB, return an error asking user to use a smaller image
            if (updateData.profilePicture.length > 1024 * 1024) {
              console.log('Profile endpoint: Profile picture too large:', updateData.profilePicture.length);
              return res.status(400).json({ 
                message: 'Profile picture is too large. Please select an image smaller than 1MB or compress your current image.' 
              });
            }
          }

          // Check if required fields are provided to set profile as verified
          if (updateData.email && updateData.phone) {
            updateData.isProfileVerified = true;
            console.log('Profile verification enabled for user:', userId);
          } else {
            console.log('Profile verification not enabled - email:', !!updateData.email, 'phone:', !!updateData.phone);
          }
          
          // Validate game account IDs are numeric if provided
          if (updateData.gamesPlayed?.pubg) {
            if (updateData.gameAccounts?.pubg?.uid && !/^\d+$/.test(updateData.gameAccounts.pubg.uid)) {
              return res.status(400).json({ message: 'PUBG Player UID must be numeric' });
            }
          }
          
          if (updateData.gamesPlayed?.mlbb) {
            if (updateData.gameAccounts?.mlbb?.userId && !/^\d+$/.test(updateData.gameAccounts.mlbb.userId)) {
              return res.status(400).json({ message: 'Mobile Legends User ID must be numeric' });
            }
            
            if (updateData.gameAccounts?.mlbb?.zoneId && !/^\d+$/.test(updateData.gameAccounts.mlbb.zoneId)) {
              return res.status(400).json({ message: 'Mobile Legends Zone ID must be numeric' });
            }
          }
          
          if (updateData.gamesPlayed?.coc) {
            if (updateData.gameAccounts?.coc?.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(updateData.gameAccounts.coc.email)) {
              return res.status(400).json({ message: 'Clash of Clans email must be a valid email address' });
            }
          }
          
          // Prepare game accounts data
          let gameAccounts: any = null;
          if (updateData.gamesPlayed) {
            gameAccounts = {};
            if (updateData.gamesPlayed.pubg && updateData.gameAccounts?.pubg) {
              gameAccounts.pubg = {
                ign: updateData.gameAccounts.pubg.ign || '',
                uid: updateData.gameAccounts.pubg.uid || ''
              };
            }
            if (updateData.gamesPlayed.mlbb && updateData.gameAccounts?.mlbb) {
              gameAccounts.mlbb = {
                userId: updateData.gameAccounts.mlbb.userId || '',
                zoneId: updateData.gameAccounts.mlbb.zoneId || ''
              };
            }
            if (updateData.gamesPlayed.coc && updateData.gameAccounts?.coc) {
              gameAccounts.coc = {
                email: updateData.gameAccounts.coc.email || ''
              };
            }
          }
          
          // Update user in database
          const client = await pool.connect();
          try {
            // Check if user provided a referral code
            if (updateData.referredBy) {
              // Handle referral code usage
              const referralResult = await handleReferralCodeUsage(client, userId, updateData.referredBy);
              if (!referralResult.success) {
                console.log('Referral code processing failed:', referralResult.message);
                // Don't fail the entire profile update if referral processing fails
                // Just log the error and continue
              } else {
                console.log('Referral code processed successfully, tokens awarded:', referralResult.tokensAwarded);
              }
            }
            
            const result = await client.query(
              `UPDATE app_users 
               SET email = $1, phone = $2, country = $3, language = $4, game_accounts = $5, is_profile_verified = $6, profile_picture = $7, updated_at = NOW()
               WHERE id = $8
               RETURNING id, pi_uid, username, email, phone, country, language, wallet_address, game_accounts, is_active, is_profile_verified, tokens, profile_picture, created_at, updated_at`,
              [
                updateData.email,
                updateData.phone,
                updateData.country || 'BT',
                updateData.language || 'en',
                gameAccounts ? JSON.stringify(gameAccounts) : null,
                updateData.isProfileVerified || false,
                updateData.profilePicture || null,
                userId
              ]
            );
            
            if (result.rows.length === 0) {
              return res.status(404).json({ message: 'User not found' });
            }
            
            // Map database columns to expected API response format
            let updatedUser = {
              id: result.rows[0].id,
              piUID: result.rows[0].pi_uid,
              username: result.rows[0].username,
              email: result.rows[0].email,
              phone: result.rows[0].phone,
              country: result.rows[0].country,
              language: result.rows[0].language,
              walletAddress: result.rows[0].wallet_address,
              gameAccounts: result.rows[0].game_accounts,
              // Updated to fetch referral code from the referral_codes table
              referralCode: await getUserReferralCode(result.rows[0].id),
              isActive: result.rows[0].is_active,
              isProfileVerified: result.rows[0].is_profile_verified,
              tokens: result.rows[0].tokens,
              profilePicture: result.rows[0].profile_picture,
              createdAt: result.rows[0].created_at,
              updatedAt: result.rows[0].updated_at,
            };
            
            // Ensure user has a referral code - generate one if not present
            if (!updatedUser.referralCode) {
              const referralCode = generateReferralCode();
              // Insert the new referral code into the referral_codes table
              try {
                await client.query(
                  'INSERT INTO referral_codes (code, user_id) VALUES ($1, $2)',
                  [referralCode, updatedUser.id]
                );
                updatedUser.referralCode = referralCode;
                console.log('Referral code generated for:', updatedUser.username, referralCode);
              } catch (referralError: any) {
                // Handle foreign key constraint violations or other errors
                console.error('Error generating referral code for user:', updatedUser.id, referralError.message);
                // Don't fail the entire profile update process if referral code generation fails
                // The user can still use the app without a referral code
              }
            }
            
            console.log('Profile endpoint: Profile updated successfully for user', userId);
            
            // Send profile update email notification
            try {
              await sendProfileUpdateEmail({
                to: updateData.email,
                username: updatedUser.username,
                profileData: updateData
              });
              console.log('Profile endpoint: Profile update email sent successfully to', updateData.email);
            } catch (emailError) {
              console.error('Profile endpoint: Failed to send profile update email:', emailError);
            }
            
            return res.status(200).json(updatedUser);
          } finally {
            client.release();
          }
        } else {
          return res.status(405).json({ message: 'Method not allowed' });
        }
      } else {
        // Unknown token algorithm
        console.log('Profile endpoint: Unknown token algorithm:', header?.alg);
        return res.status(401).json({ message: 'Invalid token algorithm. Only server-issued tokens are accepted.' });
      }
    } catch (error: any) {
      console.error('Profile endpoint: Failed to decode token or fetch user data', error);
      // More descriptive error messages
      if (error.name === 'JsonWebTokenError') {
        return res.status(401).json({ message: 'Invalid token format', error: error.message });
      } else if (error.name === 'TokenExpiredError') {
        return res.status(401).json({ message: 'Token expired', error: error.message });
      } else {
        return res.status(401).json({ message: 'Invalid token or failed to fetch user data', error: error.message });
      }
    }
  }

  // If we don't have a real Pi Server API Key, return an error
  console.log('Profile endpoint: Pi Server API Key not configured');
  return res.status(500).json({ message: 'Pi Server API Key not configured' });
}

async function handleTransactions(req: VercelRequest, res: VercelResponse) {
  const startTime = Date.now();
  const requestId = Math.random().toString(36).substring(2, 15);
  
  console.log(`[${requestId}] Transactions endpoint: Request received`, {
    method: req.method,
    url: req.url,
    headers: req.headers,
    query: req.query,
    startTime: new Date().toISOString()
  });

  if (req.method !== "GET") {
    const errorResponse = { 
      message: "Method not allowed", 
      method: req.method, 
      allowedMethods: ["GET"],
      requestId 
    };
    console.log(`[${requestId}] Transactions endpoint: Method not allowed`, errorResponse);
    return res.status(405).json(errorResponse);
  }

  try {
    // Get the authorization token to extract user info
    // Support both standard Authorization header and Vercel's OIDC token
    const authHeader = req.headers.authorization || req.headers['x-vercel-oidc-token'];
    
    if (!authHeader) {
      const errorResponse = { 
        message: 'No authorization header provided', 
        requestId 
      };
      console.log(`[${requestId}] Transactions endpoint: No authorization header provided`, errorResponse);
      return res.status(401).json(errorResponse);
    }
    
    // Ensure we're working with a string (headers can be arrays)
    const headerValue = Array.isArray(authHeader) ? authHeader[0] : authHeader;
    // Strip the Bearer prefix if present
    const token = headerValue?.startsWith('Bearer ') ? headerValue.substring(7) : headerValue;
    
    // Validate token format first
    if (!token || token.split('.').length !== 3) {
      const errorResponse = { 
        message: 'Malformed token or invalid JWT', 
        requestId 
      };
      console.log(`[${requestId}] Transactions endpoint: Malformed token`, errorResponse);
      return res.status(401).json(errorResponse);
    }
    
    // Debug JWT header to check algorithm
    let header;
    try {
      header = JSON.parse(Buffer.from(token.split('.')[0], 'base64').toString());
      console.log(`[${requestId}] JWT Header:`, header);
    } catch (decodeError) {
      const errorResponse = { 
        message: 'Could not decode JWT header for debugging', 
        requestId 
      };
      console.log(`[${requestId}] Transactions endpoint: JWT decode error`, errorResponse);
    }
    
    // Handle different token types
    if (header && header.alg === 'RS256') {
      // This is a Pi Network token - we should not accept it for transactions endpoint
      // Transactions endpoint should only accept our server-issued HS256 tokens
      const errorResponse = { 
        message: 'Invalid token. Transactions endpoint only accepts server-issued tokens.', 
        tokenAlgorithm: header?.alg,
        requestId 
      };
      console.log(`[${requestId}] Transactions endpoint: Rejecting RS256 token`, errorResponse);
      return res.status(401).json(errorResponse);
    } else if (header && header.alg === 'HS256') {
      // This is our server-issued token - verify it
      // Verify the JWT token and extract user ID
      // Force HS256 algorithm for HMAC-signed tokens
      const jwtLib = await import('jsonwebtoken');
      const decoded: any = jwtLib.verify(token, JWT_SECRET, { algorithms: ['HS256'] });
      const userId = decoded.userId;
      
      console.log(`[${requestId}] Transactions endpoint: Token verified for user`, { userId });
      
      // Get query parameters for filtering and sorting
      const { status, sort } = req.query;
      
      console.log(`[${requestId}] Transactions endpoint: Query parameters`, { status, sort });
      
      // Build the SQL query with optional filters
      let baseQuery = `
        SELECT t.id, t.user_id, t.package_id, t.payment_id, t.txid, t.pi_amount, t.usd_amount, t.pi_price_at_time, 
        t.status, t.game_account, t.metadata, t.email_sent, t.created_at, t.updated_at,
        p.name as package_name, p.game as package_game, p.in_game_amount as package_in_game_amount,
        p.usdt_value as package_usdt_value, p.image as package_image
        FROM transactions t
        JOIN packages p ON t.package_id = p.id
        WHERE t.user_id = $1
      `;
      
      const queryParams: any[] = [userId];
      
      // Add status filter if provided
      if (status && status !== 'all') {
        baseQuery += ` AND t.status = $2`;
        queryParams.push(status);
      }
      
      // Add sorting
      if (sort === 'amount') {
        baseQuery += ` ORDER BY t.pi_amount DESC`;
      } else {
        baseQuery += ` ORDER BY t.created_at DESC`;
      }
      
      console.log(`[${requestId}] Transactions endpoint: SQL query`, { 
        query: baseQuery, 
        params: queryParams 
      });
      
      // Fetch transactions directly from database using raw SQL
      const client = await pool.connect();
      try {
        console.log(`[${requestId}] Transactions endpoint: Fetching transactions for user`, { userId });
        
        const result = await client.query(baseQuery, queryParams);
        
        console.log(`[${requestId}] Transactions endpoint: Fetched transactions`, { 
          userId, 
          count: result.rows.length,
          duration: Date.now() - startTime 
        });
        
        // Map database columns to expected API response format
        const transactions = result.rows.map(row => ({
          id: row.id,
          userId: row.user_id,
          packageId: row.package_id,
          paymentId: row.payment_id,
          txid: row.txid,
          piAmount: row.pi_amount,
          usdAmount: row.usd_amount,
          piPriceAtTime: row.pi_price_at_time,
          status: row.status,
          gameAccount: row.game_account,
          metadata: row.metadata,
          emailSent: row.email_sent,
          createdAt: row.created_at,
          updatedAt: row.updated_at,
          package: {
            id: row.package_id,
            name: row.package_name,
            game: row.package_game,
            inGameAmount: row.package_in_game_amount,
            usdtValue: row.package_usdt_value,
            image: row.package_image,
            isActive: true,
            createdAt: row.created_at,
            updatedAt: row.updated_at,
          }
        }));
        
        const responseTime = Date.now() - startTime;
        console.log(`[${requestId}] Transactions endpoint: Returning transactions`, { 
          userId, 
          count: transactions.length,
          responseTime,
          success: true 
        });
        
        res.status(200).json(transactions);
      } finally {
        client.release();
        console.log(`[${requestId}] Transactions endpoint: Database client released`);
      }
    } else {
      // Unknown token algorithm
      const errorResponse = { 
        message: 'Invalid token algorithm. Only server-issued tokens are accepted.', 
        tokenAlgorithm: header?.alg,
        requestId 
      };
      console.log(`[${requestId}] Transactions endpoint: Unknown token algorithm`, errorResponse);
      return res.status(401).json(errorResponse);
    }
  } catch (error: any) {
    const errorResponse = { 
      message: 'Invalid token or failed to fetch transactions', 
      error: error.message,
      stack: process.env.NODE_ENV === 'development' ? error.stack : undefined,
      requestId,
      duration: Date.now() - startTime
    };
    
    console.error(`[${requestId}] Transactions endpoint: Fetch error`, errorResponse);
    
    // More descriptive error messages
    if (error.name === 'JsonWebTokenError') {
      return res.status(401).json({ 
        message: 'Invalid token format', 
        error: error.message,
        requestId 
      });
    } else if (error.name === 'TokenExpiredError') {
      return res.status(401).json({ 
        message: 'Token expired', 
        error: error.message,
        requestId 
      });
    } else if (error.code === 'ENOTFOUND' || error.code === 'ECONNREFUSED') {
      return res.status(500).json({ 
        message: 'Database connection failed', 
        error: error.message,
        requestId 
      });
    } else {
      return res.status(500).json(errorResponse);
    }
  }
}

