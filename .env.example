# B4U Esports Environment Variables

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret
JWT_SECRET=your-secret-key-here
SESSION_SECRET=your-session-secret-here

# Google AI Studio API (for AI Chat Assistant) - FREE
# Get your API key from: https://aistudio.google.com/
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Pi Network Configuration
PI_SERVER_API_KEY=your-pi-server-api-key-here
PI_SANDBOX_MODE=true
VITE_PI_SANDBOX_MODE=true

# Marketing Email Secret
MARKETING_EMAIL_SECRET=your-marketing-email-secret-here

# Admin Email
ADMIN_EMAIL=b4uesportspi@gmail.com
DEVELOPER_EMAIL=b4uesportspi@gmail.com

# SMTP Configuration (Hostinger or other provider)
# Service: smtp.hostinger.com
# Port: 587 (TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS='your-password-here'
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=Your App Name

# Application Configuration
NODE_ENV=development
NETWORK=TESTNET
APP_URL=http://localhost:3000

# CoinGecko API
COINGECKO_API_KEY=your_coingecko_api_key_here
